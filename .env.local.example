# ============================================
# VIRA - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y completa los valores
# NO subas .env.local a git

# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# ============================================
# Google Gemini 2.5 Flash (IA + TTS)
# ============================================
# API key principal para IA y generación de audio
GOOGLE_GEMINI_API_KEY=AIzaSyC9Ut0-HNNkm2Bz3L5qGGz4uWZXvJEs1pM
GOOGLE_PROJECT_ID=telegram-api-464919

# ============================================
# Scraping
# ============================================
# API key para extraer noticias de sitios web
SCRAPINGBEE_API_KEY=xxx

# ============================================
# Cron Jobs (Opcional)
# ============================================
# Secret para proteger endpoints de cron
CRON_SECRET=xxx

# ============================================
# Configuración de la Aplicación
# ============================================
# URL base de la aplicación (para callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Proveedores Alternativos TTS (Opcionales)
# ============================================
# Puedes configurar proveedores adicionales como fallback
# ElevenLabs, Azure, OpenAI, etc. (no requeridos con Gemini)

# ============================================
# Notas
# ============================================
# - Gemini 2.5 Flash se usa para:
#   1. Humanización de texto de noticias
#   2. Ajuste de duración de noticias
#   3. Generación de cierres de noticieros
#   4. Generación de audio TTS
#
# - Para producción, usa una API key de Gemini real
#   La API key de ejemplo está incluida para desarrollo
